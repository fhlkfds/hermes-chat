[Desktop Entry]
Type=Application
Name=Flagstop
GenericName=Hermes Agent Client
Comment=Desktop client for your Hermes Agent servers
Keywords=hermes;agent;chat;
Exec=env WEBKIT_DISABLE_DMABUF_RENDERER=1 hermes-chat %u
Icon=hermes-chat
Terminal=false
Categories=Network;Chat;
StartupWMClass=hermes-chat
# Chat links (hermes-chat://chat?…, ADR 0037) open in Flagstop. The link arrives as %u.
MimeType=x-scheme-handler/hermes-chat;
