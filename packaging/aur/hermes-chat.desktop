[Desktop Entry]
Type=Application
Name=Hermes Chat
Comment=Chat with a remote Hermes Agent
Exec=env WEBKIT_DISABLE_DMABUF_RENDERER=1 hermes-chat %u
Icon=hermes-chat
Terminal=false
Categories=Network;Chat;
StartupWMClass=hermes-chat
# Chat links (hermes-chat://chat?…, ADR 0037) open in Hermes Chat. The link arrives as %u.
MimeType=x-scheme-handler/hermes-chat;
