+
+# --- Project chat membership -------------------------------------------------------------------
+# Which sessions (chats) are in which project, kept per profile beside the projects themselves so
+# every client signed in to the profile shows the same. One row per (project, session), kept when a
+# session is taken out (member = 0) so its revision fences later changes. A project's rows go with
+# it (ON DELETE CASCADE); sessions and folders are never touched.
+_MEMBERSHIP_SQL = """
+CREATE TABLE IF NOT EXISTS project_chats (
+    project_id TEXT NOT NULL REFERENCES projects(id) ON DELETE CASCADE,
+    session_id TEXT NOT NULL,
+    member INTEGER NOT NULL,
+    rev INTEGER NOT NULL,
+    changed_at REAL NOT NULL,
+    PRIMARY KEY (project_id, session_id));
+CREATE TABLE IF NOT EXISTS project_chat_ops (
+    op_id TEXT PRIMARY KEY,
+    result TEXT NOT NULL,
+    applied_at REAL NOT NULL);
+CREATE TABLE IF NOT EXISTS project_chat_revision (
+    id INTEGER PRIMARY KEY CHECK (id = 1),
+    revision INTEGER NOT NULL);
+INSERT OR IGNORE INTO project_chat_revision (id, revision) VALUES (1, 0);
+"""
+_MEMBERSHIP_OPS_MAX = 500
+
+
+def _membership_revision(conn, ensure: bool = False) -> int:
+    # executescript commits first, so the tables are made only outside a write transaction.
+    if ensure:
+        conn.executescript(_MEMBERSHIP_SQL)
+    return int(conn.execute("SELECT revision FROM project_chat_revision WHERE id = 1").fetchone()[0])
+
+
+def _bump_membership_revision(conn) -> int:
+    conn.execute("UPDATE project_chat_revision SET revision = revision + 1 WHERE id = 1")
+    return _membership_revision(conn)
+
+
+def _session_ref(v) -> str:
+    ref = str(v or "")
+    if not ref or len(ref) > 400:
+        raise ValueError("session_id must be 1 to 400 characters")
+    return ref
 
 
