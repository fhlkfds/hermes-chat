 @_projects_method("projects.delete")
 def _(rid, params, pdb, conn) -> dict:
+    _membership_revision(conn, ensure=True)
     pdb.delete_project(conn, _require_project(pdb, conn, params).id)
+    _bump_membership_revision(conn)  # its project_chats rows went with it (ON DELETE CASCADE)
