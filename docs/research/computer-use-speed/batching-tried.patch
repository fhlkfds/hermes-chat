+    #[test]
+    fn bytes_after_a_quiet_spell_go_at_once_and_a_burst_goes_together() {
+        let window = Duration::from_millis(8);
+        let mut b = Batcher::new(window);
+        let t0 = Instant::now();
+        assert_eq!(b.push(&[1], t0), Some(vec![1]), "the first bytes go at once");
+        assert_eq!(b.due(), None);
+        // A burst within the window waits, in order, for the window to end.
+        assert_eq!(b.push(&[2, 3], t0 + Duration::from_millis(1)), None);
+        assert_eq!(b.push(&[4], t0 + Duration::from_millis(5)), None);
+        assert_eq!(b.due(), Some(t0 + window));
+        assert_eq!(b.take(t0 + window), Some(vec![2, 3, 4]));
+        assert_eq!(b.take(t0 + window), None, "nothing is sent twice");
+        // The next window starts from that batch.
+        assert_eq!(b.push(&[5], t0 + window + Duration::from_millis(2)), None);
+        assert_eq!(b.due(), Some(t0 + window * 2));
+        // Bytes after a quiet spell go at once, with any still waiting before them.
+        assert_eq!(b.push(&[6], t0 + window * 3), Some(vec![5, 6]));
+    }
+
