 /// How long a close may take to send before the socket is just dropped.
 const CLOSE_WAIT: Duration = Duration::from_secs(2);
 
+/// How long RFB bytes may wait for others to go to the webview with them, after the last batch went.
+const BATCH_WINDOW: Duration = Duration::from_millis(8);
+/// A batch this large goes at once.
+const MAX_BATCH: usize = 4 << 20;
+
+/// Gathers the stream's bytes into batches for the webview. Bytes that come when no batch went for `window` go at
+/// once (`push` gives them back); later ones wait until `window` after the last batch (`due`), then go together.
+struct Batcher {
+    window: Duration,
+    pending: Vec<u8>,
+    last_sent: Option<Instant>,
+}
+
+impl Batcher {
+    fn new(window: Duration) -> Self {
+        Self { window, pending: Vec::new(), last_sent: None }
+    }
+
+    /// Adds `bytes`; the batch to send now, if one is due.
+    fn push(&mut self, bytes: &[u8], now: Instant) -> Option<Vec<u8>> {
+        self.pending.extend_from_slice(bytes);
+        let quiet = self.last_sent.is_none_or(|at| now >= at + self.window);
+        (quiet || self.pending.len() >= MAX_BATCH).then(|| self.take(now)).flatten()
+    }
+
+    /// When the bytes waiting are due to go, if any are waiting.
+    fn due(&self) -> Option<Instant> {
+        (!self.pending.is_empty()).then(|| self.last_sent.map_or_else(Instant::now, |at| at + self.window))
+    }
+
+    /// The bytes waiting, if any, as a batch sent `now`.
+    fn take(&mut self, now: Instant) -> Option<Vec<u8>> {
+        if self.pending.is_empty() {
+            return None;
+        }
+        self.last_sent = Some(now);
+        Some(std::mem::take(&mut self.pending))
+    }
+}
