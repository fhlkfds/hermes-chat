@@ -0,0 +1,90 @@
+// BENCH-172 (temporary, not committed): the real Screen, signed in by URL to a bench dashboard, with timings out.
+import { createRoot } from "react-dom/client";
+import { invoke } from "@tauri-apps/api/core";
+import "./styles.css";
+import { connect } from "./hermes/transport";
+import { tauriPipe } from "./hermes/tauriPipe";
+import { ScreenTab, loadNoVnc, type RfbConstructor } from "./ui/Screen";
+import { localChatCache } from "./hermes/chatCache";
+import type { OpenPipe } from "./hermes/pipe";
+
+const now = () => performance.timeOrigin + performance.now();
+const lines: string[] = [];
+setInterval(() => {
+  if (lines.length) void invoke("bench_trace", { lines: lines.splice(0) });
+}, 500);
+
+export async function runScreenBench() {
+  const env = import.meta.env;
+  const details = { mode: "url" as const, sshTarget: "", url: env.VITE_SCREEN_BENCH_URL, username: "bench", password: env.VITE_SCREEN_BENCH_PW };
+  // Each /api/ws frame's synchronous handling (parse + reduce), timed.
+  const real = tauriPipe(details);
+  const timed: OpenPipe = (onEvent, profile, signal) =>
+    real(
+      (e) => {
+        const t = now();
+        onEvent(e);
+        const dt = now() - t;
+        const text = (e as { text?: string }).text;
+        if (text && (text.length > 20000 || dt > 8)) lines.push(`frame ${t.toFixed(3)} ${text.length} ${dt.toFixed(2)}`);
+      },
+      profile,
+      signal,
+    );
+  const base = localChatCache(details);
+  const cache = {
+    ...base,
+    saveTranscript: (p: string, id: string, items: Parameters<typeof base.saveTranscript>[2]) => {
+      const t = now();
+      base.saveTranscript(p, id, items);
+      lines.push(`save ${t.toFixed(3)} ${JSON.stringify(items).length} ${(now() - t).toFixed(2)} kept=${!!localStorage.getItem(Object.keys(localStorage).find((k) => k.includes(id)) ?? "-")}`);
+    },
+  };
+  const hermes = await connect(timed, "default", cache);
+  // A main-thread stall shows as a late animation frame.
+  let last = now();
+  const tick = () => {
+    const t = now();
+    if (t - last > 50) lines.push(`stall ${t.toFixed(3)} ${(t - last).toFixed(1)}`);
+    last = t;
+    requestAnimationFrame(tick);
+  };
+  requestAnimationFrame(tick);
+  (window as unknown as { benchTurn: (text: string) => Promise<void> }).benchTurn = async (text: string) => {
+    const chatId = await hermes.newChat();
+    lines.push(`turn ${now().toFixed(3)} ${chatId}`);
+    await hermes.send(chatId, text);
+  };
+  setTimeout(() => void (window as unknown as { benchTurn: (t: string) => Promise<void> }).benchTurn(env.VITE_SCREEN_BENCH_PROMPT), Number(env.VITE_SCREEN_BENCH_DELAY ?? 20000));
+  const api = hermes.screen;
+  const openSocket: typeof api.openSocket = (ticket, onData, onClose) =>
+    api.openSocket(
+      ticket,
+      (bytes) => {
+        lines.push(`js ${now().toFixed(3)} ${bytes.byteLength}`);
+        onData(bytes);
+      },
+      onClose,
+    );
+  const loadRfb = async (): Promise<RfbConstructor> => {
+    const Rfb = await loadNoVnc();
+    return class extends (Rfb as unknown as new (...a: unknown[]) => object) {
+      constructor(...a: unknown[]) {
+        super(...a);
+        const display = (this as unknown as { _display: { flip(q?: boolean): void; _renderQ: unknown[] } })._display;
+        const flip = display.flip.bind(display);
+        display.flip = (fromQueue?: boolean) => {
+          const draws = display._renderQ.length === 0 || fromQueue;
+          flip(fromQueue);
+          if (draws) lines.push(`flip ${now().toFixed(3)}`);
+        };
+      }
+    } as unknown as RfbConstructor;
+  };
+  document.body.style.height = "100vh";
+  createRoot(document.getElementById("root")!).render(
+    <div style={{ height: "100vh", display: "flex", flexDirection: "column" }}>
+      <ScreenTab api={{ ...api, openSocket }} shown connected loadRfb={loadRfb} />
+    </div>,
+  );
+}
