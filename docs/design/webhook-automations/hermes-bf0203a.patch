+    ledger.set_state(None, "gh", "o-3", "failed", reason="admission_unavailable")
+    ledger.reserve_retry(None, "gh", "o-3", "key-0003")
+    ledger.begin(None, "gh", "o-3~retry~key-0003", event="issues", payload=ISSUE, body=b"{}", retry_of="o-3",
+                 idempotency_key="key-0003")
+    ledger.set_state(None, "gh", "o-3~retry~key-0003", "failed", reason="http_500")
+    # GitHub's redelivery of the original (it never ran) is processed and is now under way.
+    assert ledger.begin(None, "gh", "o-3", event="issues", payload=ISSUE, body=json.dumps(ISSUE).encode())[0] == "new"
+    ledger.set_state(None, "gh", "o-3", "queued")
+    assert not _views(client)["o-3~retry~key-0003"]["retryable"]
+    answer = client.post("/api/webhooks/gh/deliveries/o-3~retry~key-0003/retry",
+                         json={"idempotency_key": "key-0004", "confirm_side_effects": True})
+    assert answer.status_code == 409
