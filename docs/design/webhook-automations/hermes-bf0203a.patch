@@ -0,0 +1,383 @@
+"""Durable delivery ledger for webhook routes (the `webhooks/1` automations contract).
+
+Every request that passes the route's signature check, its replay window and the rate limit is stored here once,
+keyed by ``(profile, route, provider delivery id)``, BEFORE any filtering, coalescing or task creation. The row then
+records what became of it: ``received`` -> ``filtered`` | ``coalesced`` -> ``superseded`` | ``queued`` -> ``running``
+-> ``completed`` | ``failed``. A request that fails authentication is never stored (it is untrusted, and storing it
+would let anyone fill the disk); only a per-route counter of rejections is kept.
+
+The ledger is the durable replay guard: a delivery id seen within the retention window, or (on a GitHub route) the
+same signed body under another id, creates no second task, across gateway restarts. An owner's retry is reserved here
+by the dashboard before it is sent, so at most one attempt at an event is ever under way.
+
+Agent-run states (queued/running/completed/failed) are not copied here: they are read at query time from the
+profile's own admission ledger (``session_admissions``), which is the authority on them.
+
+One SQLite file per profile home: ``$HERMES_HOME/webhook_deliveries.db`` (0600). The gateway and the dashboard are
+separate processes; every write is one ``BEGIN IMMEDIATE`` transaction, so check-then-write is atomic between them.
+"""
+from __future__ import annotations
+
+import contextlib
+import hashlib
+import json
+import os
+import sqlite3
+import threading
+import time
+from pathlib import Path
+from typing import Any, Iterator, Optional
+
+RETENTION_SECONDS = 7 * 24 * 3600  # longer than GitHub's 3-day manual-redelivery window
+MAX_ROWS_PER_ROUTE = 1000
+EXCERPT_CHARS = 600
+# A provider may resend these: nothing ran, so the redelivery is processed instead of answered as a duplicate.
+PROVIDER_RETRYABLE = frozenset({"admission_unavailable", "profile_not_served"})
+# The gateway refuses an owner's retry signed longer ago than this (its replay window, +-300 s). A reservation the
+# gateway hasn't claimed by then can never be claimed, so it stops blocking other attempts.
+RETRY_WINDOW_SECONDS = 300 + 60
+REJECTION_KINDS = ("bad_signature", "stale_timestamp", "missing_delivery_id", "too_large", "rate_limited", "paused",
+                   "no_secret")
+
+_SCHEMA = """
+CREATE TABLE IF NOT EXISTS deliveries (
+  profile TEXT NOT NULL, route TEXT NOT NULL, delivery_id TEXT NOT NULL,
+  event TEXT NOT NULL DEFAULT '', action TEXT,
+  received_at REAL NOT NULL, updated_at REAL NOT NULL,
+  state TEXT NOT NULL, reason TEXT, owner TEXT,
+  session_chat_id TEXT, coalesce_key TEXT, superseded_by TEXT,
+  duplicates INTEGER NOT NULL DEFAULT 0, last_duplicate_at REAL,
+  retry_of TEXT, idempotency_key TEXT, body BLOB, body_sha256 TEXT, excerpt TEXT,
+  PRIMARY KEY (profile, route, delivery_id));
+CREATE INDEX IF NOT EXISTS deliveries_recent ON deliveries(profile, route, received_at DESC);
+CREATE INDEX IF NOT EXISTS deliveries_body ON deliveries(profile, route, body_sha256);
+CREATE INDEX IF NOT EXISTS deliveries_retry ON deliveries(profile, route, retry_of);
+CREATE TABLE IF NOT EXISTS rejections (
+  profile TEXT NOT NULL, route TEXT NOT NULL, kind TEXT NOT NULL,
+  count INTEGER NOT NULL DEFAULT 0, last_at REAL,
+  PRIMARY KEY (profile, route, kind));
+CREATE TABLE IF NOT EXISTS meta (key TEXT PRIMARY KEY, value TEXT);
+"""
+
+_lock = threading.Lock()  # one writer per process; BEGIN IMMEDIATE orders the processes
+
+
+def ledger_path(home: Optional[Path] = None) -> Path:
+    if home is None:
+        from hermes_constants import get_hermes_home
+        home = get_hermes_home()
+    return Path(home) / "webhook_deliveries.db"
+
+
+def excerpt(payload: Any) -> str:
+    """A short, sanitized look at the payload for the history: the event's own identifying fields only."""
+    if not isinstance(payload, dict):
+        return ""
+    picks: dict[str, Any] = {}
+    for key in ("action", "ref", "number"):
+        if isinstance(payload.get(key), (str, int)):
+            picks[key] = payload[key]
+    for obj, fields in (("repository", ("full_name",)), ("pull_request", ("number", "title")),
+                        ("issue", ("number", "title")), ("release", ("tag_name",)), ("sender", ("login",)),
+                        ("workflow_run", ("name", "conclusion"))):
+        value = payload.get(obj)
+        if isinstance(value, dict):
+            for f in fields:
+                if isinstance(value.get(f), (str, int)):
+                    picks[f"{obj}.{f}"] = value[f]
+    return json.dumps(picks, ensure_ascii=False)[:EXCERPT_CHARS]
+
+
+class Ledger:
+    """One profile home's delivery ledger, for the gateway (ingress) and the dashboard (history, retry)."""
+
+    def __init__(self, home: Optional[Path] = None, *, retention_seconds: float = RETENTION_SECONDS,
+                 max_rows_per_route: int = MAX_ROWS_PER_ROUTE):
+        self.path = ledger_path(home)
+        self.state_db = self.path.parent / "state.db"
+        self.retention_seconds = retention_seconds
+        self.max_rows_per_route = max_rows_per_route
+
+    # --- connections ---
+
+    @contextlib.contextmanager
+    def _write(self) -> Iterator[sqlite3.Connection]:
+        with _lock:
+            self.path.parent.mkdir(parents=True, exist_ok=True)
+            fresh = not self.path.exists()
+            conn = sqlite3.connect(str(self.path), timeout=10, isolation_level=None)
+            try:
+                if fresh:
+                    os.chmod(self.path, 0o600)
+                conn.row_factory = sqlite3.Row
+                conn.executescript(_SCHEMA)
+                conn.execute("BEGIN IMMEDIATE")
+                try:
+                    yield conn
+                except BaseException:
+                    conn.execute("ROLLBACK")
+                    raise
+                conn.execute("COMMIT")
+            finally:
+                conn.close()
+
+    @contextlib.contextmanager
+    def _read(self) -> Iterator[Optional[sqlite3.Connection]]:
+        if not self.path.exists():
+            yield None
+            return
+        conn = sqlite3.connect(f"file:{self.path}?mode=ro", uri=True, timeout=10)
+        conn.row_factory = sqlite3.Row
+        try:
+            yield conn
+        finally:
+            conn.close()
+
+    # --- what a row means ---
+
+    @staticmethod
+    def _instance(conn) -> Optional[str]:
+        row = conn.execute("SELECT value FROM meta WHERE key='gateway_instance'").fetchone()
+        return row["value"] if row else None
+
+    def _never_ran(self, conn, row, now: float) -> bool:
+        """Whether a stored delivery provably started nothing, so it may be processed again: refused for admission;
+        stored as received by a gateway process that has since been replaced (a live one may still be acting on it,
+        however long its script takes); a retry the gateway refused, or never claimed within the retry window."""
+        state = row["state"]
+        return ((state == "failed" and row["reason"] in PROVIDER_RETRYABLE | {"not_sent"})
+                or (state == "received" and row["owner"] != self._instance(conn))
+                or (state == "reserved" and now - row["received_at"] > RETRY_WINDOW_SECONDS))
+
+    def _effective(self, conn, row, now: float) -> dict:
+        """A row as the owner sees it: an agent task's state from the admission ledger; a delivery that never got
+        going as failed. ``{state, reason, session_id, outcome}``."""
+        state, reason = row["state"], row["reason"]
+        if state in ("received", "reserved") and self._never_ran(conn, row, now):
+            why = "not_sent" if state == "reserved" else "interrupted"
+            return {"state": "failed", "reason": why, "session_id": None, "outcome": why}
+        if state == "reserved":
+            return {"state": "received", "reason": "retry_sent", "session_id": None, "outcome": None}
+        run = run_state(self.state_db, row["session_chat_id"]) if state in ("queued", "running") else None
+        if run is None:
