+"""webhooks/1: the delivery ledger stores each authenticated delivery once, before anything acts on it, and refuses
+replays durably; refused requests are only counted. (Hermes Chat automations contract, reference implementation.)"""
+import hashlib
+import hmac
+import json
+import time
+
+import pytest
+from aiohttp import web
+from aiohttp.test_utils import TestClient, TestServer
+
+from gateway.config import PlatformConfig
+from gateway.platforms.webhook import WebhookAdapter, retry_signature
+from gateway.platforms.webhook_ledger import Ledger
+
+SECRET = "ledger-contract-secret"
+ISSUE = {"action": "opened", "issue": {"number": 7, "title": "Crash", "labels": [{"name": "bug"}]},
+         "repository": {"full_name": "example/fixture"}}
+
+
+def _adapter(**route_extra) -> WebhookAdapter:
+    route = {"secret": SECRET, "events": ["issues"], "prompt": "Issue #{issue.number}", "deliver": "log",
+             "provider": "github", **route_extra}
+    return WebhookAdapter(PlatformConfig(enabled=True, extra={"host": "127.0.0.1", "port": 0,
+                                                              "routes": {"gh": route}, "rate_limit": 100}))
+
+
+def _app(adapter: WebhookAdapter) -> web.Application:
+    from tests.gateway.fixtures.webhook_route_authority import mount_authority
+    app = web.Application()
+    mount_authority(app, adapter)
+    app.router.add_post("/webhooks/{route_name}", adapter._handle_webhook)
+    return app
+
+
+def _signed(body: bytes, delivery: str, event: str = "issues", secret: str = SECRET) -> dict:
+    return {"Content-Type": "application/json", "X-GitHub-Event": event, "X-GitHub-Delivery": delivery,
+            "X-Hub-Signature-256": "sha256=" + hmac.new(secret.encode(), body, hashlib.sha256).hexdigest()}
+
+
+def _rows(adapter):
+    return {r["delivery_id"]: r for r in adapter._ledger(None).list(None, "gh", limit=50)}
+
+
+@pytest.mark.asyncio
+async def test_signed_delivery_is_stored_before_work_and_a_replay_never_makes_a_second_task():
+    adapter = _adapter()
+    seen = []
+
+    async def capture(event):
+        seen.append(event)
+
+    adapter.handle_message = capture
+    body = json.dumps(ISSUE).encode()
+    async with TestClient(TestServer(_app(adapter))) as cli:
+        first = await cli.post("/webhooks/gh", data=body, headers=_signed(body, "d-1"))
+        assert first.status == 202 and (await first.json())["status"] == "accepted"
+        # The provider's own redelivery: same id.
+        again = await cli.post("/webhooks/gh", data=body, headers=_signed(body, "d-1"))
+        assert (again.status, (await again.json())["status"]) == (200, "duplicate")
+        # A captured request replayed under a NEW delivery id: GitHub's signature doesn't cover the header.
+        forged = await cli.post("/webhooks/gh", data=body, headers=_signed(body, "d-forged"))
+        assert (forged.status, (await forged.json())["status"]) == (200, "duplicate")
+    rows = _rows(adapter)
+    assert set(rows) == {"d-1"}
+    assert rows["d-1"]["state"] == "queued" and rows["d-1"]["session_chat_id"].startswith("webhook:v2:")
+    assert rows["d-1"]["duplicates"] == 2
+    assert len(seen) == 1
