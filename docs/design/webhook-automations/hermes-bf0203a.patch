+# Outcomes after which the task may have acted (tools, messages), so a retry needs the owner's confirmation.
+_STARTED_OUTCOMES = {"failed", "interrupted", "settled_unknown", "cancelled"}
+
+
+def _delivery_view(ledger, profile: Optional[str], route: str, row: dict, enabled: bool) -> dict[str, Any]:
+    """One delivery for the history: its state as the owner sees it (the admission ledger's, for an agent task) and
+    whether it can be retried: failed, with a stored body, on a running route, and no other attempt at the same event
+    (the original or any retry of it) under way or done."""
+    import json as _json
+
+    seen = ledger.view(profile, route, row)
+    try:
+        excerpt = _json.loads(row.get("excerpt") or "{}")
+    except ValueError:
+        excerpt = {}
+    retryable = seen["state"] == "failed" and bool(row.get("body")) and enabled and not seen["blocked"]
+    return {
+        "delivery_id": row["delivery_id"], "event": row["event"], "action": row.get("action"),
+        "received_at": row["received_at"], "updated_at": row["updated_at"], "state": seen["state"],
+        "reason": seen["reason"], "session_id": seen["session_id"], "outcome": seen["outcome"],
+        "duplicates": row["duplicates"], "last_duplicate_at": row.get("last_duplicate_at"),
+        "retry_of": row.get("retry_of"), "coalesce_key": row.get("coalesce_key"),
+        "superseded_by": row.get("superseded_by"), "excerpt": excerpt, "retryable": retryable,
+        "retry_needs_confirmation": retryable and (seen["outcome"] in _STARTED_OUTCOMES or seen["reason"] == "delivery_failed"),
+    }
+
