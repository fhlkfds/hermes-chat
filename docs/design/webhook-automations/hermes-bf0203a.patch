+"""webhooks/1 dashboard routes: delivery history and the owner's retry (Hermes Chat automations contract)."""
+import io
+import json
+import threading
+import time
+
+import pytest
+
+from gateway.platforms.webhook_ledger import RETRY_WINDOW_SECONDS, Ledger
+
+ISSUE = {"action": "opened", "issue": {"number": 7, "title": "Crash"}, "repository": {"full_name": "example/fixture"}}
+
+
+@pytest.fixture
+def client(_isolate_hermes_home):
+    from starlette.testclient import TestClient
+
+    import hermes_state
+    from hermes_cli.config import load_config, save_config
+    from hermes_cli.web_server import _SESSION_HEADER_NAME, _SESSION_TOKEN, app
+    from hermes_constants import get_hermes_home
+
+    hermes_state.DEFAULT_DB_PATH = get_hermes_home() / "state.db"
+    cfg = load_config()
+    cfg.setdefault("platforms", {})["webhook"] = {"enabled": True, "extra": {"host": "127.0.0.1", "port": 8644}}
+    save_config(cfg)
+    c = TestClient(app)
+    c.headers[_SESSION_HEADER_NAME] = _SESSION_TOKEN
+    made = c.post("/api/webhooks", json={"name": "gh", "provider": "github", "events": ["issues"], "create_only": True})
+    assert made.status_code == 200, made.text
+    return c
+
+
+def _failed(ledger, delivery_id, **kw):
+    ledger.begin(None, "gh", delivery_id, event="issues", payload=ISSUE, body=json.dumps(ISSUE).encode(), **kw)
+    ledger.set_state(None, "gh", delivery_id, "failed", reason="http_500")
+
+
+def _views(client):
+    return {d["delivery_id"]: d for d in client.get("/api/webhooks/gh/deliveries").json()["deliveries"]}
+
+
+def test_a_failed_retry_doesnt_block_another(client):
+    ledger = Ledger()
+    _failed(ledger, "o-1")
+    # A retry that a gateway stored and never acted on before it stopped: it failed, so it blocks nothing.
+    ledger.claim_instance("gateway-a")
+    ledger.begin(None, "gh", "o-1~retry~key-0001", event="issues", payload=ISSUE, body=b"{}", retry_of="o-1",
+                 idempotency_key="key-0001", owner="gateway-a")
+    ledger.claim_instance("gateway-b")
+    views = _views(client)
+    assert views["o-1~retry~key-0001"]["state"] == "failed" and views["o-1~retry~key-0001"]["retryable"]
+    assert views["o-1"]["retryable"]
+    # A retry that is still under way blocks every other attempt at the same event.
+    ledger.begin(None, "gh", "o-1~retry~key-0002", event="issues", payload=ISSUE, body=b"{}", retry_of="o-1",
+                 idempotency_key="key-0002")
+    ledger.set_state(None, "gh", "o-1~retry~key-0002", "queued")
+    views = _views(client)
+    assert not views["o-1"]["retryable"] and not views["o-1~retry~key-0001"]["retryable"]
+
+
+def test_two_retries_at_once_start_one_task(client, monkeypatch):
+    import urllib.request
+
+    _failed(Ledger(), "o-2")
+    sent = []
+
+    class Answer(io.BytesIO):
+        status = 202
+
+        def __enter__(self):
+            return self
+
+        def __exit__(self, *exc):
+            return False
+
+    def gateway(req, timeout=None):
+        # The gateway's listener: it stores the retry as it arrives, after a moment.
+        headers = {k.lower(): v for k, v in req.header_items()}
+        time.sleep(0.3)
+        retry_id = f"{headers['x-hermes-retry-of']}~retry~{headers['x-hermes-retry-key']}"
+        Ledger().begin(None, "gh", retry_id, event="issues", payload=ISSUE, body=req.data,
+                       retry_of=headers["x-hermes-retry-of"], idempotency_key=headers["x-hermes-retry-key"])
+        Ledger().set_state(None, "gh", retry_id, "queued")
+        sent.append(retry_id)
+        return Answer(json.dumps({"status": "accepted", "delivery_id": retry_id}).encode())
+
+    monkeypatch.setattr(urllib.request, "urlopen", gateway)
+    answers = []
+
+    def retry(key):
+        answers.append(client.post("/api/webhooks/gh/deliveries/o-2/retry",
+                                   json={"idempotency_key": key, "confirm_side_effects": True}).status_code)
+
+    threads = [threading.Thread(target=retry, args=(k,)) for k in ("key-aaaa1111", "key-bbbb2222")]
+    for t in threads:
+        t.start()
+    for t in threads:
+        t.join()
+    assert sorted(answers) == [200, 409]
+    assert len(sent) == 1
+
