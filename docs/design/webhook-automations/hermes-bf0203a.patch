+    """webhooks/1: run a failed delivery again, as a new delivery ``<original>~retry~<key>`` through the gateway's
+    whole pipeline (filters, coalescing, dedupe), signed by this server with the route's secret. The same
+    ``idempotency_key`` never makes a second task. 409 when it isn't retryable, or when the failed attempt had started
+    (its tools may have acted) and ``confirm_side_effects`` isn't set."""
+    if not _RETRY_KEY_RE.match(body.idempotency_key or ""):
+        raise HTTPException(status_code=400, detail="idempotency_key: 8 to 64 letters, digits, '-' or '_'.")
+
+    def _retry():
+        import json as _json
+        import socket
+        import urllib.error
+        import urllib.request
+
+        import hermes_cli.webhook as wh
+        from gateway.platforms.webhook import _route_secret, retry_signature
+        from gateway.platforms.webhook_ledger import Ledger
+
+        subscriptions = wh._load_subscriptions()
+        key = _webhook_key_in(subscriptions, name)
+        route = subscriptions[key]
+        profile_name = route.get("profile")
+        ledger = Ledger()
+        row = ledger.get(profile_name, key, delivery_id)
+        if row is None:
+            raise HTTPException(status_code=404, detail="No such delivery in this route's history.")
+        enabled = route.get("enabled", True) is not False
+        if not enabled:
+            raise HTTPException(status_code=409, detail={"code": "paused", "message": "The route is paused. Resume it to retry."})
+        view = _delivery_view(ledger, profile_name, key, row, enabled)
+        secret = _route_secret(route, (wh._get_webhook_config().get("extra", {}) or {}).get("secret", ""))
+        if not isinstance(secret, str) or not secret.strip():
+            raise HTTPException(status_code=409, detail={"code": "no_secret", "message": "The route's secret isn't available to sign the retry."})
+        if view["retry_needs_confirmation"] and not body.confirm_side_effects:
+            raise HTTPException(status_code=409, detail={"code": "needs_confirmation",
+                                                         "message": "The failed attempt had started, so its tools may have acted. Confirm to run it again."})
+        # Reserved atomically with the check that no other attempt at this event is under way or done; the
+        # reservation stands until the gateway claims it, or the retry window passes and it no longer can.
+        outcome, reserved = ledger.reserve_retry(profile_name, key, delivery_id, body.idempotency_key)
+        if outcome == "already":
+            return {"status": "already_sent", "delivery_id": reserved["delivery_id"]}
+        if outcome != "reserved":
+            state = view["state"] if outcome == "missing" else ledger.view(profile_name, key, reserved)["state"]
+            raise HTTPException(status_code=409, detail={"code": "not_retryable", "message": (
+                f"Only a failed delivery can be retried; this one is {view['state']}." if view["state"] != "failed"
+                else f"Another attempt at this event is {state}, so this one isn't run again.")})
+        rid, root = reserved["delivery_id"], reserved["retry_of"]
+        ts = str(int(time.time()))
+        headers = {"Content-Type": "application/json", "X-Hermes-Retry-Of": root,
+                   "X-Hermes-Retry-Key": body.idempotency_key, "X-Hermes-Retry-Timestamp": ts,
+                   "X-Hermes-Retry-Signature": retry_signature(secret, ts, root, body.idempotency_key, reserved["body"])}
+        if reserved["event"] and reserved["event"] != "unknown":
+            headers["X-GitHub-Event"] = reserved["event"]
+        req = urllib.request.Request(wh._route_url(key, route), data=reserved["body"], method="POST", headers=headers)
+        try:
+            with urllib.request.urlopen(req, timeout=30) as resp:
+                status, answer = resp.status, _json.loads(resp.read() or b"{}")
+        except urllib.error.HTTPError as exc:
+            status, answer = exc.code, {"error": exc.read().decode(errors="replace")[:300]}
+        except (TimeoutError, socket.timeout) as exc:
+            # It may still arrive: the reservation keeps every other attempt out until it is claimed or expires.
+            raise HTTPException(status_code=504, detail={"code": "uncertain", "delivery_id": rid, "message": (
+                "The gateway didn't answer in time, so the retry may or may not run. The history will show it; "
+                "retrying again with the same key won't start a second task.")}) from exc
+        except OSError as exc:
+            ledger.release(profile_name, key, rid)  # never reached the listener
+            raise HTTPException(status_code=503,
+                                detail="The gateway's webhook listener isn't reachable, so nothing was retried.") from exc
+        if status >= 400:
+            ledger.release(profile_name, key, rid)  # refused before it was claimed: nothing ran
+            raise HTTPException(status_code=502, detail={"code": "gateway_refused", "status": status, "answer": answer})
+        return {"status": answer.get("status", "accepted"), "delivery_id": answer.get("delivery_id"),
+                "route": key, "gateway_status": status}
