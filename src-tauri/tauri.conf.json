{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hermes Chat",
  "version": "0.1.0",
  "identifier": "net.l0cky12.hermes-chat",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Hermes Chat", "width": 1280, "height": 820, "minWidth": 760, "minHeight": 500 }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png"]
  }
}
